{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda-documentos.py\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Conferindo números travados, palavras proibidas e §2.4"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda-painel.py\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Conferindo se o painel acompanhou a mudança"
          }
        ]
      }
    ]
  }
}
