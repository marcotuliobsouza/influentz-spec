{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(docs/marca/**)",
      "Write(docs/marca/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(git push origin main:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)"
    ],
    "allow": [
      "Read",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(python3 .claude/guardas/verificar.py:*)",
      "Bash(python3 .claude/guardas/testes.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda-comandos.py\"",
            "timeout": 15,
            "statusMessage": "Conferindo se o comando é destrutivo ou decisão do Founder"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda-documentos.py\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Conferindo números travados, palavras proibidas e §2.4"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda-painel.py\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Conferindo se o painel acompanhou a mudança"
          }
        ]
      }
    ]
  }
}
